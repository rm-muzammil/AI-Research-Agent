# ═══════════════════════════════════════════════════════════
# AI Research Agent - Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Gemini API (Free Tier) ─────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Serper.dev (1,000 free searches/month) ─────────────────
# Get your key from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# ── Optional: Brave Search API (2,000 free/month) ──────────
# Alternative to Serper: https://api.search.brave.com/app/keys
BRAVE_API_KEY=your_brave_api_key_here

# ── n8n Configuration ──────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_pass
POSTGRES_DB=ai_research
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_SMALL=phi4        # For routing, extraction, classification
OLLAMA_MODEL_MEDIUM=llama3.1:8b  # For researcher, fact checker